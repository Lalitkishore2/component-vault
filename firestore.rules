rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /component_vaults/{userId} {
      // Strictly enforce that only the authorized owner (svlalitk2k@gmail.com) with a verified email can read or write vault data
      allow read, write: if request.auth != null && 
        request.auth.token.email == 'svlalitk2k@gmail.com' &&
        request.auth.token.email_verified == true;
      
      match /{allChildren=**} {
        allow read, write: if request.auth != null && 
          request.auth.token.email == 'svlalitk2k@gmail.com' &&
          request.auth.token.email_verified == true;
      }
    }
  }
}

